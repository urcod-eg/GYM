{
  "name": "gym-pwa",
  "version": "1.2.0-phase2",
  "description": "Gym Management PWA — urcod",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit -p . && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p . && tsc --noEmit -p tsconfig.tests.json",
    "lint:rules": "eslint -c eslint.rules.config.js firestore.rules",
    "test:rules": "firebase emulators:exec --only firestore --project demo-gym \"vitest run -c vitest.rules.config.ts\"",
    "test:all": "npm run typecheck && npm test && npm run lint:rules && npm run test:rules",
    "emulators": "firebase emulators:start --only auth,firestore,hosting --project demo-gym",
    "deploy": "npm run build && firebase deploy --only firestore,hosting"
  },
  "author": "urcod — Mahmoud Gamal Eldeen",
  "license": "UNLICENSED",
  "dependencies": {
    "firebase": "^13.0.0",
    "luxon": "^3.7.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@firebase/eslint-plugin-security-rules": "^0.0.2",
    "@firebase/rules-unit-testing": "^6.0.0",
    "@types/luxon": "^3.7.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "antlr4": "^4.13.1",
    "eslint": "^9.39.5",
    "firebase-tools": "^15.33.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vite-plugin-singlefile": "^2.3.3",
    "vitest": "^5.0.4"
  },
  "private": true,
  "type": "module"
}
