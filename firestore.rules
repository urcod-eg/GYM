rules_version = '2';

// Gym PWA — Firestore security rules (Phase 2, free Spark plan).
//
// There is no server code on the free plan, so these rules are the only guard. Every write the app
// makes is built by src/domain/writes.ts; tests/rules commits those exact write sets against the
// emulator. Principles:
//   * Roles come from users/{uid}, which only an invite redemption can create and only an admin or
//     the developer can change. Nothing a browser sends can grant a role.
//   * Every sensitive change carries a fresh audit entry in the same atomic write
//     (lastAuditId on the changed document ⇄ auditLogs/{id} pointing back at it).
//   * Staff writes need a valid licence. Developer writes need a second factor (TOTP).
//   * Anything not listed is denied.
service cloud.firestore {
  match /databases/{database}/documents {

    // ---------------------------------------------------------------- paths
    function userPath(u)    { return /databases/$(database)/documents/users/$(u); }
    function memberPath(m)  { return /databases/$(database)/documents/members/$(m); }
    function invitePath(h)  { return /databases/$(database)/documents/invites/$(h); }
    function aliasPath(a)   { return /databases/$(database)/documents/loginAliases/$(a); }
    function phonePath(p)   { return /databases/$(database)/documents/phoneIndex/$(p); }
    function auditPath(a)   { return /databases/$(database)/documents/auditLogs/$(a); }
    function licensePath()  { return /databases/$(database)/documents/license/main; }
    function configPath()   { return /databases/$(database)/documents/gymPublicConfig/main; }
    function counterPath()  { return /databases/$(database)/documents/counters/members; }
    function sessionPath(u) { return /databases/$(database)/documents/staffSessions/$(u); }
    function triesPath(u)   { return /databases/$(database)/documents/pinTries/$(u); }
    function secretPath(u)  { return /databases/$(database)/documents/pinSecrets/$(u); }
    function planPath(p)    { return /databases/$(database)/documents/plans/$(p); }
    function settingsPath() { return /databases/$(database)/documents/gymSettings/main; }
    function msPath(id)     { return /databases/$(database)/documents/memberships/$(id); }
    function payPath(id)    { return /databases/$(database)/documents/payments/$(id); }
    function tokenPath(m)   { return /databases/$(database)/documents/checkinTokens/$(m); }
    function checkinPath(id) { return /databases/$(database)/documents/checkins/$(id); }

    // ---------------------------------------------------------------- who is asking
    function signedIn() { return request.auth != null; }
    function me() { return get(userPath(request.auth.uid)).data; }
    // Firestore allows only a few document lookups per rule, so each helper reads a document once
    // (a missing document makes get() fail, which counts as "no").
    function active() { return signedIn() && me().status == 'active'; }
    // Rules may evaluate at most 1000 expressions, so the helpers below read the account once (u).
    // Staff roles count only in a session opened with the 4-digit code for this very sign-in
    // (auth_time changes with every new sign-in, so a stolen password alone is not enough).
    function staffSessionOk() {
      return get(sessionPath(request.auth.uid)).data.authTime == request.auth.token.auth_time;
    }
    // Staff and the developer: roles count only after the second step (code / code + security phrase).
    function hasRole(r) { return signedIn() && roleOn(me(), r); }
    function roleOn(u, r) { return u.status == 'active' && r in u.roles && (u.kind == 'member' || staffSessionOk()); }
    // Any of these staff roles, in a session opened for this sign-in.
    function staffAny(rs) { return signedIn() && staffAnyOn(me(), rs); }
    function staffAnyOn(u, rs) { return u.status == 'active' && u.kind != 'member' && u.roles.hasAny(rs) && staffSessionOk(); }
    function isDev() { return hasRole('developer'); }
    function isAdmin() { return staffAny(['admin', 'developer']); }
    function isAccountant() { return hasRole('accountant'); }
    function isCashier() { return hasRole('cashier'); }
    function isCoach() { return hasRole('coach'); }
    function isStaff() { return signedIn() && staffOn(me()); }
    function staffOn(u) { return u.status == 'active' && u.kind in ['staff', 'developer'] && staffSessionOk(); }
    function isFrontDesk() { return staffAny(['admin', 'developer', 'accountant', 'cashier']); }

    // Developer writes need the developer's own session (code + security phrase for this sign-in).
    // isDev() already includes it through hasRole(); the name stays for readability.
    function devMfa() { return isDev(); }

    function licensed() {
      let l = get(licensePath()).data;
      return l.state == 'ACTIVE' && (l.endsAt == null || request.time < l.endsAt);
    }
    // Staff writes need a valid licence; the developer's do not.
    function writerOn(u, rs) { return staffAnyOn(u, rs) && ('developer' in u.roles || licensed()); }
    function adminWriter() { return signedIn() && writerOn(me(), ['admin', 'developer']); }
    // Managing another staff account: never yourself; admins only non-admins; the developer (2FA) anyone.
    function canManageStaff(u) {
      let t = get(userPath(u)).data;
      return signedIn() && u != request.auth.uid && t.kind == 'staff' && managerOf(me(), t);
    }
    function managerOf(a, t) {
      return staffAnyOn(a, ['admin', 'developer']) && ('developer' in a.roles || (licensed() && !('admin' in t.roles)));
    }
    // Wiping member data: the developer, who re-entered the code + phrase in the last 10 minutes
    // (re-entering re-opens the session, so its `at` is the time of that check). Staff data is never touched.
    function devWipe() { return devMfa() && get(sessionPath(request.auth.uid)).data.at > request.time - duration.value(10, 'm'); }
    function frontDeskWriter() { return signedIn() && writerOn(me(), ['admin', 'cashier', 'developer']); }

    // A block counts until its `until` time (null = until lifted).
    function blockedNow(b, scope) { return scope in b && (b[scope].get('until', null) == null || b[scope].until > request.time); }
    function memberMayUseApp(m) {
      let b = get(memberPath(m)).data.blocks;
      return !blockedNow(b, 'LOGIN_BLOCK') && !blockedNow(b, 'TEMPORARY_SUSPENSION');
    }
    function isMemberSelf(m) { return signedIn() && memberSelfOn(me(), m); }
    function memberSelfOn(u, m) { return u.status == 'active' && u.kind == 'member' && u.memberId == m && memberMayUseApp(m); }
    function ownsMemberDoc() { return isMemberSelf(resource.data.memberId); }

    function onlyChanges(keys) { return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys); }
    function exactKeys(keys) { return request.resource.data.keys().hasOnly(keys) && request.resource.data.keys().hasAll(keys); }

    function validPhone(p) { return p is string && p.matches('^[+]20(10|11|12|15)[0-9]{8}$'); }
    function validLoginEmail(e) { return e is string && e.matches('^[ms]-[0-9a-f]{24}@login[.]urcod[.]invalid$'); }

    // The write must create a new audit entry describing exactly this change.
    function freshAudit(action, type, id) {
      let a = request.resource.data.lastAuditId;
      let e = getAfter(auditPath(a)).data;
      // Written in this very request (the audit collection is create-only, so it is a new entry).
      return a is string && e.at == request.time
        && e.action == action && e.entityType == type && e.entityId == id;
    }

    // An invite redeemed in this very request by the signed-in (brand new) account.
    function redeemedNow(inv) { return inv.usedBy == request.auth.uid && inv.usedAt == request.time; }

    // ---------------------------------------------------------------- default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // ---------------------------------------------------------------- public gym identity
    match /gymPublicConfig/{id} {
      allow read: if true;
      allow create, update: if id == 'main' && devMfa() && brandingShape() && freshAudit('branding.set', 'gymPublicConfig', 'main');
    }
    function brandingShape() {
      let d = request.resource.data;
      return exactKeys(['nameAr', 'nameEn', 'codePrefix', 'primaryColor', 'supportPhone', 'logoDataUrl', 'updatedAt', 'updatedBy', 'lastAuditId'])
        && d.nameAr is string && d.nameAr.size() >= 2 && d.nameAr.size() <= 60
        && d.nameEn is string && d.nameEn.size() >= 2 && d.nameEn.size() <= 60
        && d.codePrefix is string && d.codePrefix.matches('^[A-Z]{2,5}$')
        && d.primaryColor is string && d.primaryColor.matches('^#[0-9A-F]{6}$')
        && validPhone(d.supportPhone)
        && (d.logoDataUrl == null
            || (d.logoDataUrl is string && d.logoDataUrl.size() <= 200000
                && d.logoDataUrl.matches('^data:image/(png|webp|jpeg);base64,[A-Za-z0-9+/=]+$')))
        && d.updatedBy == request.auth.uid
        && d.updatedAt == request.time;
    }

    // ---------------------------------------------------------------- licence
    match /license/{id} {
      allow get: if active();
      allow create, update: if id == 'main' && devMfa() && licenseShape() && freshAudit('license.set', 'license', 'main');
    }
    function licenseShape() {
      let d = request.resource.data;
      return exactKeys(['type', 'state', 'startsAt', 'endsAt', 'version', 'note', 'updatedAt', 'updatedBy', 'lastAuditId'])
        && d.type in ['TRIAL', 'FIXED', 'LIFETIME']
        && d.state in ['ACTIVE', 'SUSPENDED']
        && d.startsAt is timestamp
        && ((d.type == 'LIFETIME' && d.endsAt == null)
            || (d.type != 'LIFETIME' && d.endsAt is timestamp && d.endsAt > d.startsAt
                && d.endsAt <= d.startsAt + duration.value(3650, 'd')
                && (d.type != 'TRIAL' || d.endsAt <= d.startsAt + duration.value(60, 'd'))))
        && ((resource == null && d.version == 1) || (resource != null && d.version == resource.data.version + 1))
        && d.note is string && d.note.size() <= 200
        && d.updatedBy == request.auth.uid
        && d.updatedAt == request.time;
    }

    // ---------------------------------------------------------------- sign-in aliases (phone → internal e-mail)
    // Readable by id only (the sign-in screen looks up one phone). Written only while redeeming an invite.
    match /loginAliases/{a} {
      allow get: if true;
      allow create: if aliasWrite(a) && getAfter(invitePath(request.resource.data.inviteId)).data.prevUid == null;
      allow update: if aliasWrite(a) && getAfter(invitePath(request.resource.data.inviteId)).data.prevUid == resource.data.uid;
      // Freed when an admin removes the staff account in the same write.
      allow delete: if (canManageStaff(resource.data.uid) && getAfter(userPath(resource.data.uid)).data.status == 'removed')
        || (a.matches('^m[+]20[0-9]{10}$') && devWipe());
    }
    function aliasWrite(a) {
      let d = request.resource.data;
      let inv = getAfter(invitePath(d.inviteId)).data;
      return signedIn()
        && exactKeys(['email', 'uid', 'inviteId', 'at'])
        && d.uid == request.auth.uid
        && d.email == request.auth.token.email
        && validLoginEmail(d.email)
        && d.at == request.time
        && redeemedNow(inv)
        && inv.aliasId == a;
    }

    // ---------------------------------------------------------------- invites (activation / password reset links)
    // The id is the SHA-256 of a 256-bit code that only the link holder knows, so `get` is open and
    // `list` is not.
    match /invites/{h} {
      allow get: if true;
      allow list: if isAdmin();
      allow create: if h.matches('^[0-9a-f]{64}$') && inviteShape()
        && ((request.resource.data.kind == 'member' && memberInviteOk())
            || (request.resource.data.kind == 'staff' && staffInviteOk()));
      allow update: if redeeming(h);
      allow delete: if (resource.data.usedAt == null
          && (adminWriter() || (frontDeskWriter() && resource.data.createdBy == request.auth.uid)))
        || (resource.data.kind == 'member' && devWipe());
    }
    function inviteShape() {
      let d = request.resource.data;
      return exactKeys(['kind', 'purpose', 'aliasId', 'phone', 'displayName', 'roles', 'memberId', 'prevUid', 'identityCheck', 'createdBy', 'createdAt', 'expiresAt', 'usedAt', 'usedBy'])
        && d.purpose in ['activate', 'reset']
        && validPhone(d.phone)
        && d.displayName is string && d.displayName.size() >= 2 && d.displayName.size() <= 80
        && d.roles is list && d.roles.size() > 0
        && d.createdBy == request.auth.uid
        && d.createdAt == request.time
        && d.expiresAt is timestamp && d.expiresAt > request.time && d.expiresAt < request.time + duration.value(48, 'h')
        && d.usedAt == null && d.usedBy == null;
    }
    function memberInviteOk() {
      let d = request.resource.data;
      let m = get(memberPath(d.memberId)).data;
      return d.roles == ['member']
        && d.aliasId == 'm' + d.phone
        && m.phoneE164 == d.phone
        && m.fullName == d.displayName
        && ((d.purpose == 'activate' && frontDeskWriter() && m.authUid == null && d.prevUid == null && d.identityCheck == null)
            || (d.purpose == 'reset' && adminWriter() && m.authUid != null && d.prevUid == m.authUid
                && d.identityCheck in ['IN_PERSON', 'PHONE_CALL']));
    }
    function staffInviteOk() {
      let d = request.resource.data;
      return d.memberId == null && d.identityCheck == null
        && d.aliasId == 's' + d.phone
        && inviterOk(me(), d.roles)
        && ((d.purpose == 'activate' && d.prevUid == null && !exists(aliasPath(d.aliasId)))
            || (d.purpose == 'reset' && d.prevUid is string && staffResetTarget(d)));
    }
    // The developer invites any staff role; an admin (licensed) any role but admin.
    function inviterOk(a, roles) {
      return staffAnyOn(a, ['admin', 'developer'])
        && ('developer' in a.roles ? roles.hasOnly(['admin', 'accountant', 'cashier', 'coach'])
            : (licensed() && roles.hasOnly(['accountant', 'cashier', 'coach'])));
    }
    function staffResetTarget(d) {
      let t = get(userPath(d.prevUid)).data;
      return get(aliasPath(d.aliasId)).data.uid == d.prevUid
        && t.kind == 'staff' && t.status == 'active' && t.roles == d.roles;
    }
    function redeeming(h) {
      return signedIn()
        && resource.data.usedAt == null && resource.data.usedBy == null
        && resource.data.expiresAt > request.time
        && onlyChanges(['usedAt', 'usedBy'])
        && request.resource.data.usedAt == request.time
        && request.resource.data.usedBy == request.auth.uid
        && getAfter(userPath(request.auth.uid)).data.inviteId == h;
    }

    // ---------------------------------------------------------------- people
    match /users/{u} {
      allow get: if signedIn() && (request.auth.uid == u || isAdmin());
      allow list: if isAdmin();
      allow create: if signedIn() && request.auth.uid == u && redeemedProfile(u);
      allow update: if 'replacedBy' in request.resource.data.diff(resource.data).affectedKeys() ? retiredByReset(u) : staffEdit(u);
      allow delete: if resource.data.kind == 'member' && devWipe();
    }
    function redeemedProfile(u) {
      let d = request.resource.data;
      let inv = getAfter(invitePath(d.inviteId)).data;
      return exactKeys(['kind', 'roles', 'status', 'displayName', 'phone', 'memberId', 'inviteId', 'createdAt'])
        && redeemedNow(inv)
        && d.kind == inv.kind && d.roles == inv.roles
        && d.displayName == inv.displayName && d.phone == inv.phone && d.memberId == inv.memberId
        && d.status == 'active'
        && d.createdAt == request.time
        && getAfter(aliasPath(inv.aliasId)).data.uid == u
        && (inv.kind != 'member' || getAfter(memberPath(inv.memberId)).data.authUid == u)
        && (inv.prevUid == null || getAfter(userPath(inv.prevUid)).data.status == 'replaced');
    }
    // A reset retires the old account in the same batch that creates the new one.
    function retiredByReset(u) {
      let d = request.resource.data;
      let inv = getAfter(invitePath(getAfter(userPath(request.auth.uid)).data.inviteId)).data;
      return signedIn() && u != request.auth.uid
        && resource.data.status == 'active'
        && onlyChanges(['status', 'replacedBy', 'updatedAt'])
        && d.status == 'replaced' && d.replacedBy == request.auth.uid && d.updatedAt == request.time
        && redeemedNow(inv) && inv.prevUid == u;
    }
    function staffEdit(u) {
      let t = resource.data;
      let d = request.resource.data;
      let a = me();
      return signedIn() && u != request.auth.uid
        && t.kind == 'staff' && t.status in ['active', 'disabled']
        && onlyChanges(['roles', 'status', 'displayName', 'updatedAt', 'lastAuditId'])
        && d.status in ['active', 'disabled', 'removed']
        && d.roles is list && d.roles.size() > 0
        && d.displayName is string && d.displayName.size() >= 2 && d.displayName.size() <= 80
        && d.updatedAt == request.time
        && staffAnyOn(a, ['admin', 'developer'])
        && ('developer' in a.roles ? d.roles.hasOnly(['admin', 'accountant', 'cashier', 'coach'])
            : (licensed() && !('admin' in t.roles) && d.roles.hasOnly(['accountant', 'cashier', 'coach'])))
        && ((d.status == 'removed' && freshAudit('staff.remove', 'users', u))
            || (d.status != 'removed' && freshAudit('staff.update', 'users', u)));
    }

    // ---------------------------------------------------------------- staff sign-in code (4-digit PIN)
    // pinSecrets: salt + SHA-256(salt + code). No browser can read it; only these rules use it.
    match /pinSecrets/{u} {
      allow create, update: if exactKeys(['salt', 'hash', 'setBy', 'setAt', 'lastAuditId'])
        && request.resource.data.salt is string && request.resource.data.salt.matches('^[0-9a-f]{32}$')
        && request.resource.data.hash is string && request.resource.data.hash.matches('^[0-9a-f]{64}$')
        && request.resource.data.setBy == request.auth.uid
        && request.resource.data.setAt == request.time
        && (request.auth.uid == u ? (devOwnSecret(u) && freshAudit('dev.secret', 'pinSecrets', u))
            : (canManageStaff(u) && freshAudit('staff.pin', 'pinSecrets', u)));
    }
    // The developer sets their own code + phrase once (first sign-in), and may change it later
    // only from an open session. Nobody else can set or reset it.
    function devOwnSecret(u) {
      return signedIn() && request.auth.uid == u && active() && me().kind == 'developer'
        && ((resource == null && !exists(secretPath(u))) || (resource != null && staffSessionOk()))
        && getAfter(/databases/$(database)/documents/devSetup/$(u)).data.at == request.time;
    }
    // devSetup: tells the developer's own app that the code is set (the secret itself stays unreadable).
    match /devSetup/{u} {
      allow get: if signedIn() && request.auth.uid == u;
      allow create, update: if signedIn() && request.auth.uid == u && active() && me().kind == 'developer'
        && exactKeys(['at']) && request.resource.data.at == request.time
        && getAfter(secretPath(u)).data.setAt == request.time;
    }
    // pinTries: each attempt is written first and counted; 5 wrong in a row locks until an admin unlocks.
    match /pinTries/{u} {
      allow get: if signedIn() && (request.auth.uid == u || isAdmin());
      allow list: if isAdmin();
      // own attempt (a code) or own reset after success (no code); anyone else: an admin unlock
      allow create, update: if signedIn() && (request.auth.uid != u ? pinAdminReset(u)
        : (request.resource.data.pin == null ? pinSuccessReset(u) : pinAttemptOk(u)));
    }
    function pinAttemptOk(u) {
      let d = request.resource.data;
      return signedIn() && request.auth.uid == u && active()
        && exactKeys(['pin', 'count', 'authTime', 'at'])
        && d.pin is string
        && (me().kind == 'staff' ? d.pin.matches('^[0-9]{4}$')
            : (me().kind == 'developer' && d.pin.size() <= 140 && d.pin.matches('^[0-9]{4}:.{10,128}$')))
        && d.authTime == request.auth.token.auth_time
        && d.at == request.time
        && ((resource == null && d.count == 1) || (resource != null && d.count == resource.data.count + 1))
        && d.count <= 5;
    }
    function pinSuccessReset(u) {
      let d = request.resource.data;
      return signedIn() && request.auth.uid == u
        && exactKeys(['pin', 'count', 'authTime', 'at'])
        && d.pin == null && d.count == 0
        && d.authTime == request.auth.token.auth_time && d.at == request.time
        && getAfter(sessionPath(u)).data.authTime == request.auth.token.auth_time
        && getAfter(sessionPath(u)).data.at == request.time;
    }
    function pinAdminReset(u) {
      let d = request.resource.data;
      return canManageStaff(u)
        && exactKeys(['pin', 'count', 'authTime', 'at'])
        && d.pin == null && d.count == 0 && d.authTime == 0 && d.at == request.time;
    }
    // staffSessions: opened by the staff member with the right code for this sign-in; ended by them or an admin.
    match /staffSessions/{u} {
      allow get: if signedIn() && (request.auth.uid == u || isAdmin());
      allow list: if isAdmin();
      allow create, update: if sessionOpen(u);
      allow delete: if (signedIn() && request.auth.uid == u) || canManageStaff(u);
    }
    function sessionOpen(u) {
      let d = request.resource.data;
      let tries = get(triesPath(u)).data;
      let secret = get(secretPath(u)).data;
      return signedIn() && request.auth.uid == u && active() && me().kind in ['staff', 'developer']
        && exactKeys(['authTime', 'device', 'at'])
        && d.authTime == request.auth.token.auth_time
        && d.at == request.time
        && d.device is string && d.device.size() <= 120
        && tries.authTime == request.auth.token.auth_time
        && tries.count <= 5
        && tries.pin is string
        && hashing.sha256(secret.salt + tries.pin).toHexString().lower() == secret.hash;
    }

    match /members/{m} {
      allow get: if isMemberSelf(m) || isFrontDesk() || (isCoach() && resource.data.assignedCoachId == request.auth.uid);
      allow list: if isFrontDesk() || (isCoach() && resource.data.assignedCoachId == request.auth.uid);
      allow create: if frontDeskWriter() && newMember(m);
      allow update: if memberUpdate(m, request.resource.data.diff(resource.data).affectedKeys());
      allow delete: if devWipe();
    }
    // Firestore evaluates at most 1000 expressions per rule, so each kind of change to a member file
    // is routed to its one check by the fields it touches (each check still verifies every field).
    function memberUpdate(m, k) {
      return 'lastCheckinId' in k ? memberCheckin(m)
        : 'lastPaymentId' in k ? ('membership' in k ? memberSale(m) : memberBalancePay(m))
        : 'membership' in k ? memberCancel(m)
        : 'balance' in k ? memberGrant(m)
        : 'blocks' in k ? memberBlocks(m)
        : ('authUid' in k || 'lastInviteId' in k || 'accountStatus' in k) ? memberLinkedByInvite(m)
        : 'vipTierId' in k ? memberVip(m)
        : ('assignedCoachId' in k || 'assignedCoachName' in k) ? memberCoach(m)
        // nothing but the stamp changes (e.g. the same tier saved again)
        : (memberVip(m) || memberCoach(m) || memberBlocks(m));
    }
    function newMember(m) {
      let d = request.resource.data;
      let no = d.memberNo;
      return exactKeys(['memberNo', 'memberCode', 'fullName', 'phoneE164', 'authUid', 'accountStatus', 'assignedCoachId', 'vipTierId', 'blocks', 'searchTokens', 'lastInviteId', 'createdAt', 'createdBy', 'updatedAt', 'lastAuditId'])
        && no is int
        // The counter rule (counterBump) checks the number against the stored counter; here we only
        // check that the counter moves to this member in the same write.
        && getAfter(counterPath()).data.next == no + 1
        && getAfter(counterPath()).data.lastMemberId == m
        && d.memberCode is string && d.memberCode.matches('^[A-Z]{2,5}-[0-9]+$')
        && d.memberCode.split('-')[1] == string(no)
        && d.fullName is string && d.fullName.size() >= 2 && d.fullName.size() <= 80
        && validPhone(d.phoneE164)
        && getAfter(phonePath(d.phoneE164)).data.memberId == m
        && d.authUid == null && d.accountStatus == 'PENDING_ACTIVATION'
        && (d.assignedCoachId == null || d.assignedCoachId is string)
        && d.vipTierId == null
        && d.blocks is map && d.blocks.size() == 0
        && d.searchTokens is list && d.searchTokens.size() <= 80
        && d.lastInviteId == null
        && d.createdBy == request.auth.uid
        && d.createdAt == request.time && d.updatedAt == request.time
        && freshAudit('member.register', 'members', m);
    }
    function memberLinkedByInvite(m) {
      let d = request.resource.data;
      let inv = getAfter(invitePath(d.lastInviteId)).data;
      return signedIn()
        && onlyChanges(['authUid', 'accountStatus', 'lastInviteId', 'updatedAt'])
        && d.authUid == request.auth.uid && d.accountStatus == 'ACTIVE' && d.updatedAt == request.time
        && redeemedNow(inv)
        && inv.kind == 'member' && inv.memberId == m
        && resource.data.authUid == inv.prevUid;
    }
    function memberBlocks(m) {
      let d = request.resource.data;
      return adminWriter()
        && onlyChanges(['blocks', 'updatedAt', 'lastAuditId'])
        && d.blocks is map
        && d.blocks.keys().hasOnly(['LOGIN_BLOCK', 'TEMPORARY_SUSPENSION', 'CHECKIN_BLOCK', 'PAID_FEATURES_BLOCK'])
        && d.updatedAt == request.time
        && (freshAudit('member.block', 'members', m) || freshAudit('member.unblock', 'members', m));
    }

    // Phone numbers are unique per gym: the index entry is created with the member and never changes.
    match /phoneIndex/{p} {
      allow get: if isFrontDesk();
      // Written with a new member (whose rule checks who registers) in the same request.
      allow create: if exactKeys(['memberId', 'createdAt'])
        && request.resource.data.createdAt == request.time
        && getAfter(memberPath(request.resource.data.memberId)).data.createdAt == request.time
        && getAfter(memberPath(request.resource.data.memberId)).data.phoneE164 == p;
      allow delete: if devWipe();
    }

    // Member numbers: each registration moves the counter by exactly one, in the same transaction.
    match /counters/{c} {
      allow get: if isFrontDesk();
      // Moves only with a member created in the same request (whose rule checks who registers).
      allow create: if c == 'members' && counterBump(10001);
      allow update: if c == 'members' && counterBump(resource.data.next);
      // After a wipe the numbering starts again from 10001.
      allow delete: if c == 'members' && devWipe();
    }

    // One record per wipe (who, when, how many), paired with its audit entry.
    match /wipes/{w} {
      allow get, list: if isAdmin();
      allow create: if devWipe()
        && exactKeys(['by', 'at', 'counts', 'lastAuditId'])
        && request.resource.data.by == request.auth.uid
        && request.resource.data.at == request.time
        && request.resource.data.counts is map && request.resource.data.counts.size() <= 8
        && freshAudit('data.wipe', 'wipes', w);
    }
    function counterBump(no) {
      let d = request.resource.data;
      return exactKeys(['next', 'lastMemberId', 'updatedAt'])
        && d.next == no + 1
        && d.updatedAt == request.time
        && getAfter(memberPath(d.lastMemberId)).data.createdAt == request.time
        && getAfter(memberPath(d.lastMemberId)).data.memberNo == no;
    }

    // ================================================================ Phase 3: plans, memberships, payments
    // Every amount is recomputed here from the plan, the settings and the member file, so a modified
    // browser cannot change a price, a discount, a deposit or a refund. Money is integer piasters.

    function adminLike() { return isAdmin(); }

    // ---------------------------------------------------------------- plans (admin)
    match /plans/{p} {
      allow read: if active();
      allow create, update: if adminWriter() && planShape(p) && freshAudit('plan.set', 'plans', p);
    }
    function planShape(p) {
      let d = request.resource.data;
      return p.matches('^[A-Za-z0-9_-]{2,40}$')
        && exactKeys(['code', 'nameAr', 'nameEn', 'unit', 'value', 'visitQuota', 'price', 'featured', 'active', 'sort', 'updatedAt', 'lastAuditId'])
        && d.code is string && d.code.matches('^[A-Z0-9_-]{2,12}$')
        && d.nameAr is string && d.nameAr.size() >= 1 && d.nameAr.size() <= 60
        && d.nameEn is string && d.nameEn.size() >= 1 && d.nameEn.size() <= 60
        && d.unit in ['session', 'day', 'week', 'month', 'year', 'custom']
        && d.value is int && d.value >= 1 && d.value <= 730
        && (d.visitQuota == null || (d.visitQuota is int && d.visitQuota >= 1 && d.visitQuota <= 1000))
        && d.price is int
        && ((d.unit == 'custom' && d.price == 0) || (d.unit != 'custom' && d.price > 0 && d.price <= 100000000))
        && d.featured is bool && d.active is bool
        && d.sort is int && d.sort >= 0 && d.sort <= 1000
        && d.updatedAt == request.time;
    }

    // ---------------------------------------------------------------- gym settings (admin)
    match /gymSettings/{s} {
      allow read: if isStaff();
      allow create, update: if s == 'main' && adminWriter() && settingsShape() && freshAudit('settings.set', 'gymSettings', 'main');
    }
    function settingsShape() {
      let d = request.resource.data;
      return exactKeys(['depositEnabled', 'depositMinPercent', 'depositGraceDays', 'depositMaxGraceDays', 'cashierMaxDiscount', 'updatedAt', 'lastAuditId'])
        && d.depositEnabled is bool
        && d.depositMinPercent is int && d.depositMinPercent >= 10 && d.depositMinPercent <= 90
        && d.depositGraceDays is int && d.depositGraceDays >= 1 && d.depositGraceDays <= 60
        && d.depositMaxGraceDays is int && d.depositMaxGraceDays >= d.depositGraceDays && d.depositMaxGraceDays <= 60
        && d.cashierMaxDiscount is int && d.cashierMaxDiscount >= 0 && d.cashierMaxDiscount <= 100
        && d.updatedAt == request.time;
    }
    function settings() { return get(settingsPath()).data; }

    // ---------------------------------------------------------------- memberships
    match /memberships/{id} {
      allow read: if ownsMemberDoc() || isFrontDesk();
      allow create: if frontDeskWriter() && sellOk(id);
      allow update: if cancelOk(id);
      allow delete: if devWipe();
    }
    // The period that counts on a member file: the membership, or what it was appended to if cancelled.
    function effPeriod(c) { return c == null ? null : (c.status == 'ACTIVE' ? c : c.prev); }
    function sellOk(id) {
      let d = request.resource.data;
      let p = get(planPath(d.planId)).data;
      let m = get(memberPath(d.memberId)).data;
      let bal = m.get('balance', null);
      return exactKeys(['memberId', 'planId', 'plan', 'customDays', 'startsAt', 'endsAt', 'base', 'discountPct', 'discount', 'carried', 'due', 'paidNow', 'mode', 'balanceDueAt', 'method', 'reference', 'receiptNo', 'paymentId', 'renewal', 'status', 'cancel', 'createdBy', 'createdAt', 'updatedAt', 'lastAuditId'])
        && p.active == true
        && d.renewal == (m.get('membership', null) != null)
        && d.plan == {'code': p.code, 'nameAr': p.nameAr, 'nameEn': p.nameEn, 'unit': p.unit, 'value': p.value, 'price': p.price, 'visitQuota': p.visitQuota}
        // price: the plan's, or a typed price for a custom-length plan
        && ((p.unit == 'custom' && d.customDays is int && d.customDays >= 1 && d.customDays <= 730
              && d.base is int && d.base >= 0 && d.base <= 100000000)
            || (p.unit != 'custom' && d.customDays == null && d.base == p.price))
        // discount: cashiers up to the admin's limit, admins any
        && d.discountPct is int && d.discountPct >= 0 && d.discountPct <= 100
        // discount = floor(base × % / 100), written without division
        && d.discount is int && d.discount * 100 <= d.base * d.discountPct && d.base * d.discountPct < (d.discount + 1) * 100
        && (d.discountPct == 0 || adminLike() || d.discountPct <= settings().cashierMaxDiscount)
        // an unpaid balance is carried into this sale
        && d.carried == (bal == null ? 0 : bal.remaining)
        && d.due == d.base - d.discount + d.carried
        // full payment, or a deposit within the admin's settings
        && (d.mode == 'FULL' ? (d.paidNow == d.due && d.balanceDueAt == null)
            : (d.mode == 'DEPOSIT' && p.unit != 'session' && depositOk(d, settings())))
        // method, reference and receipt number: checked on the receipt (saleReceipt), which must be in this write
        && d.paymentId is string
        // dates (no back-dating, appended to a running period, the plan's length): checked on the
        // member file (memberSale), which must change in this same write — that keeps each check
        // under Firestore's 1000-expression limit
        && d.status == 'ACTIVE' && d.cancel == null
        && d.createdBy == request.auth.uid && d.createdAt == request.time && d.updatedAt == request.time
        && getAfter(memberPath(d.memberId)).data.membership.id == id
        // the receipt is written in the same request, so every sale shows in the day's cash
        && getAfter(payPath(d.paymentId)).data.membershipId == id
        // a sale is its own record (never edited or deleted), so it has no separate audit entry
        && d.lastAuditId == null;
    }
    function depositOk(d, st) {
      return st.depositEnabled == true
        && d.paidNow is int && d.paidNow < d.due
        && d.paidNow * 100 >= d.due * st.depositMinPercent
        && d.balanceDueAt is timestamp
        && d.balanceDueAt > request.time + duration.value(1, 'd')
        && d.balanceDueAt <= request.time + duration.value(st.depositMaxGraceDays + 2, 'd');
    }
    // Day/week/custom: whole calendar days (±1h for daylight saving). Month/year: calendar months.
    function lengthOk(d, p) {
      let days = p.unit == 'session' ? 1 : (p.unit == 'day' ? p.value : (p.unit == 'week' ? 7 * p.value : (p.unit == 'custom' ? d.customDays : 0)));
      return (days > 0
              && d.endsAt >= d.startsAt + duration.value(days * 24 - 1, 'h')
              && d.endsAt <= d.startsAt + duration.value(days * 24 + 1, 'h'))
        || (p.unit == 'month' && d.endsAt >= d.startsAt + duration.value(28 * p.value, 'd') && d.endsAt <= d.startsAt + duration.value(31 * p.value + 2, 'd'))
        || (p.unit == 'year' && d.endsAt >= d.startsAt + duration.value(365 * p.value, 'd') && d.endsAt <= d.startsAt + duration.value(366 * p.value + 2, 'd'));
    }
    // Cancellation by an admin: refund at most what was paid on this membership.
    function cancelOk(id) {
      let r = resource.data;
      let d = request.resource.data;
      let c = d.cancel;
      let m = get(memberPath(r.memberId)).data;
      let bal = m.get('balance', null);
      let paid = r.due - ((bal != null && bal.membershipId == id) ? bal.remaining : 0);
      return adminWriter()
        && r.status == 'ACTIVE' && d.status == 'CANCELLED'
        && onlyChanges(['status', 'cancel', 'updatedAt', 'lastAuditId'])
        && m.membership.id == id
        && c.keys().hasOnly(['by', 'at', 'refund', 'overridden', 'reason', 'paymentId']) && c.keys().hasAll(['by', 'at', 'refund', 'overridden', 'reason', 'paymentId'])
        && c.by == request.auth.uid && c.at == request.time
        && c.refund is int && c.refund >= 0 && c.refund <= paid
        && c.overridden is bool
        && c.reason is string && c.reason.size() >= 1 && c.reason.size() <= 200
        && ((c.refund == 0 && c.paymentId == null)
            || (c.refund > 0 && c.paymentId is string && getAfter(payPath(c.paymentId)).data.amount == c.refund))
        && getAfter(memberPath(r.memberId)).data.membership.status == 'CANCELLED'
        && d.updatedAt == request.time
        && freshAudit('membership.cancel', 'memberships', id);
    }

    // ---------------------------------------------------------------- the member file follows each money write
    function memberSale(m) {
      let d = request.resource.data;
      let s = getAfter(msPath(d.membership.id)).data;
      let cur = effPeriod(resource.data.get('membership', null));
      // who may sell: checked on the membership created in this request (sellOk)
      return onlyChanges(['membership', 'balance', 'lastPaymentId', 'updatedAt'])
        && s.memberId == m && s.createdAt == request.time
        && d.membership == {'id': d.membership.id, 'planNameAr': s.plan.nameAr, 'planNameEn': s.plan.nameEn, 'unit': s.plan.unit,
                            'startsAt': s.startsAt, 'endsAt': s.endsAt, 'status': 'ACTIVE',
                            'visitQuota': s.plan.visitQuota, 'visitsUsed': 0,
                            'prev': (cur != null && cur.endsAt > request.time)
                              ? {'planNameAr': cur.planNameAr, 'planNameEn': cur.planNameEn, 'startsAt': cur.startsAt, 'endsAt': cur.endsAt}
                              : null}
        && d.balance == (s.paidNow < s.due
              ? {'remaining': s.due - s.paidNow, 'total': s.due, 'dueAt': s.balanceDueAt, 'membershipId': d.membership.id, 'graceUntil': null, 'graceReason': ''}
              : null)
        && d.lastPaymentId == s.paymentId
        && d.updatedAt == request.time
        // the sale's dates: from today (no back-dating), appended to a running period, with the plan's length
        && s.startsAt is timestamp && s.endsAt is timestamp
        && s.startsAt >= request.time - duration.value(1, 'd')
        && s.startsAt <= request.time + duration.value(62, 'd')
        && (cur == null || cur.endsAt <= request.time || s.startsAt >= cur.endsAt)
        && lengthOk(s, s.plan);
    }
    function memberBalancePay(m) {
      let d = request.resource.data;
      let b = resource.data.balance;
      let pay = getAfter(payPath(d.lastPaymentId)).data;
      // who may collect: checked on the receipt created in this request (balanceReceipt)
      return onlyChanges(['balance', 'lastPaymentId', 'updatedAt', 'lastAuditId'])
        && b != null
        && pay.kind == 'BALANCE' && pay.memberId == m && pay.at == request.time
        && pay.amount is int && pay.amount > 0 && pay.amount <= b.remaining
        && d.balance == (pay.amount == b.remaining ? null
              : {'remaining': b.remaining - pay.amount, 'total': b.total, 'dueAt': b.dueAt, 'membershipId': b.membershipId, 'graceUntil': b.graceUntil, 'graceReason': b.graceReason})
        && d.updatedAt == request.time
        && freshAudit('balance.pay', 'members', m);
    }
    function memberGrant(m) {
      let d = request.resource.data;
      let b = resource.data.balance;
      let g = d.balance;
      return adminWriter()
        && onlyChanges(['balance', 'updatedAt', 'lastAuditId'])
        && b != null && g != null
        && g.remaining == b.remaining && g.total == b.total && g.dueAt == b.dueAt && g.membershipId == b.membershipId
        && g.keys().hasOnly(['remaining', 'total', 'dueAt', 'membershipId', 'graceUntil', 'graceReason'])
        && g.graceReason is string && g.graceReason.size() <= 200
        && ((g.graceUntil == null && g.graceReason == '' && freshAudit('balance.revoke', 'members', m))
            || (g.graceUntil is timestamp && g.graceUntil > request.time
                && g.graceUntil <= request.time + duration.value(32, 'd')
                && g.graceReason.size() >= 1 && freshAudit('balance.grant', 'members', m)))
        && d.updatedAt == request.time;
    }
    function memberCancel(m) {
      let d = request.resource.data;
      let cur = resource.data.membership;
      let s = getAfter(msPath(cur.id)).data;
      let bal = resource.data.get('balance', null);
      // who may cancel: checked on the membership cancelled in this request (cancelOk)
      return onlyChanges(['membership', 'balance', 'updatedAt', 'lastAuditId'])
        && s.status == 'CANCELLED' && s.updatedAt == request.time
        && cur.status == 'ACTIVE'
        && d.membership.diff(cur).affectedKeys().hasOnly(['status']) && d.membership.status == 'CANCELLED'
        && d.balance == ((bal != null && bal.membershipId == cur.id) ? null : bal)
        && d.updatedAt == request.time && d.lastAuditId == s.lastAuditId;
    }

    // ---------------------------------------------------------------- payments (receipts): append-only
    match /payments/{id} {
      allow read: if ownsMemberDoc() || isFrontDesk();
      allow create: if paymentShape() && (saleReceipt(id) || balanceReceipt(id) || refundReceipt(id));
      allow delete: if devWipe();
    }
    function paymentShape() {
      let d = request.resource.data;
      return exactKeys(['memberId', 'membershipId', 'kind', 'amount', 'method', 'reference', 'receiptNo', 'by', 'at'])
        && d.amount is int && d.amount >= 0 && d.amount <= 100000000
        && d.method in ['CASH', 'WALLET', 'INSTAPAY', 'BANK']
        && (d.reference == null || (d.method != 'CASH' && d.reference is string && d.reference.size() >= 1 && d.reference.size() <= 40))
        && d.receiptNo is string && d.receiptNo.matches('^R-[0-9]{6}-[0-9A-Z]{5}$')
        && d.by == request.auth.uid && d.at == request.time;
    }
    function saleReceipt(id) {
      let d = request.resource.data;
      let s = getAfter(msPath(d.membershipId)).data;
      // the sale created in this request checks who sells (sellOk)
      return d.kind == 'SALE'
        && s.paymentId == id && s.createdAt == request.time
        && d.amount == s.paidNow && d.memberId == s.memberId
        && d.method == s.method && d.reference == s.reference && d.receiptNo == s.receiptNo;
    }
    function balanceReceipt(id) {
      let d = request.resource.data;
      let after = getAfter(memberPath(d.memberId)).data;
      return d.kind == 'BALANCE' && frontDeskWriter()
        && after.lastPaymentId == id && after.updatedAt == request.time
        && d.membershipId == get(memberPath(d.memberId)).data.balance.membershipId;
    }
    function refundReceipt(id) {
      let d = request.resource.data;
      let s = getAfter(msPath(d.membershipId)).data;
      // the cancellation in this request checks who refunds (cancelOk)
      return d.kind == 'REFUND'
        && s.cancel.paymentId == id && s.updatedAt == request.time
        && d.amount == s.cancel.refund && d.memberId == s.memberId && d.reference == null;
    }

    // ================================================================ Phase 4: check-in at the door
    // The member app writes a fresh random code; the cashier's scan is one atomic write and these
    // rules decide entry from the member file: a membership covering now, visits left, no block,
    // no late balance (unless an admin allowed it), a fresh unused code, not twice within 2 minutes.
    match /checkinTokens/{m} {
      allow get: if isMemberSelf(m) || isFrontDesk();
      allow create, update: if (isMemberSelf(m)
            && exactKeys(['code', 'at', 'usedAt'])
            && request.resource.data.code is string && request.resource.data.code.matches('^[A-Z2-9]{8}$')
            && request.resource.data.at == request.time && request.resource.data.usedAt == null)
        // used by a check-in in this same request (whose rule checks who checks in)
        || (resource != null && resource.data.usedAt == null
            && onlyChanges(['usedAt']) && request.resource.data.usedAt == request.time
            && getAfter(memberPath(m)).data.lastCheckInAt == request.time);
      allow delete: if devWipe();
    }
    match /checkins/{id} {
      allow read: if ownsMemberDoc() || isFrontDesk();
      allow create: if frontDeskWriter() && checkinOk(id);
      allow delete: if devWipe();
    }
    function coversNow(c) {
      return (c.status == 'ACTIVE' && c.startsAt <= request.time && request.time < c.endsAt
              && (c.get('visitQuota', null) == null || c.get('visitsUsed', 0) < c.visitQuota))
        || (c.prev != null && c.prev.startsAt <= request.time && request.time < c.prev.endsAt);
    }
    function checkinOk(id) {
      let d = request.resource.data;
      let m = get(memberPath(d.memberId)).data;
      let c = m.get('membership', null);
      let bal = m.get('balance', null);
      let last = m.get('lastCheckInAt', null);
      let after = getAfter(memberPath(d.memberId)).data;
      return exactKeys(['memberId', 'method', 'code', 'membershipId', 'by', 'at'])
        && d.by == request.auth.uid && d.at == request.time
        && c != null && coversNow(c) && d.membershipId == c.id
        && !blockedNow(m.blocks, 'CHECKIN_BLOCK') && !blockedNow(m.blocks, 'TEMPORARY_SUSPENSION')
        && (bal == null || request.time < bal.dueAt || (bal.graceUntil != null && request.time < bal.graceUntil))
        && (last == null || request.time > last + duration.value(2, 'm'))
        && ((d.method == 'MANUAL' && d.code == null)
            || (d.method == 'QR' && d.code is string && tokenOk(d.memberId, d.code)))
        && after.lastCheckInAt == request.time && after.lastCheckinId == id;
    }
    function tokenOk(m, code) {
      let tk = get(tokenPath(m)).data;
      return tk.code == code && tk.usedAt == null && request.time < tk.at + duration.value(90, 's')
        && getAfter(tokenPath(m)).data.usedAt == request.time;
    }
    // The member file records the visit; only a limited plan's counter moves (by one).
    function memberCheckin(m) {
      let d = request.resource.data;
      let r = resource.data;
      let ci = getAfter(checkinPath(d.lastCheckinId)).data;
      let c = r.membership;
      let counts = c.status == 'ACTIVE' && c.startsAt <= request.time && request.time < c.endsAt && c.get('visitQuota', null) != null;
      // who may check in: checked on the check-in created in this request (checkinOk)
      return ci.memberId == m && ci.at == request.time && d.lastCheckInAt == request.time
        && ((!counts && onlyChanges(['lastCheckInAt', 'lastCheckinId']))
            || (counts && onlyChanges(['lastCheckInAt', 'lastCheckinId', 'membership'])
                && d.membership.diff(c).affectedKeys().hasOnly(['visitsUsed'])
                && d.membership.visitsUsed == c.get('visitsUsed', 0) + 1));
    }
    // VIP tier on a member file (admin).
    function memberVip(m) {
      let d = request.resource.data;
      return adminWriter()
        && onlyChanges(['vipTierId', 'updatedAt', 'lastAuditId'])
        && (d.vipTierId == null || d.vipTierId in ['PLUS', 'ELITE'])
        && d.updatedAt == request.time
        && freshAudit('member.vip', 'members', m);
    }

    // ================================================================ Phase 5: coaches and programmes
    // A coach writes only for members assigned to them; the admin assigns coaches and edits any plan;
    // the member reads their own plans and writes only their own logs. One document per member each.
    function coachOf(m) { return hasRole('coach') && licensed() && get(memberPath(m)).data.assignedCoachId == request.auth.uid; }
    function coachReads(m) { return isCoach() && get(memberPath(m)).data.assignedCoachId == request.auth.uid; }
    function planWriter(m) { return coachOf(m) || adminWriter(); }
    function planBase(m) {
      let d = request.resource.data;
      return d.memberId == m && d.by == request.auth.uid && d.updatedAt == request.time
        && d.coachId is string && (d.coachId == request.auth.uid || adminWriter())
        && d.title is string && d.title.size() >= 1 && d.title.size() <= 60;
    }
    match /workoutPlans/{m} {
      allow get: if isMemberSelf(m) || isAdmin() || coachReads(m);
      allow create, update: if planWriter(m) && planBase(m)
        && exactKeys(['memberId', 'coachId', 'title', 'days', 'notes', 'updatedAt', 'by'])
        && request.resource.data.days is list && request.resource.data.days.size() <= 7
        && request.resource.data.notes is string && request.resource.data.notes.size() <= 500;
      allow delete: if devWipe() || planWriter(m);
    }
    match /nutritionPlans/{m} {
      allow get: if isMemberSelf(m) || isAdmin() || coachReads(m);
      allow create, update: if planWriter(m) && planBase(m)
        && exactKeys(['memberId', 'coachId', 'title', 'meals', 'notes', 'updatedAt', 'by'])
        && request.resource.data.meals is list && request.resource.data.meals.size() <= 8
        && request.resource.data.notes is string && request.resource.data.notes.size() <= 800;
      allow delete: if devWipe() || planWriter(m);
    }
    match /workoutLogs/{m} {
      allow get: if isMemberSelf(m) || isAdmin() || coachReads(m);
      allow create, update: if isMemberSelf(m)
        && exactKeys(['memberId', 'days', 'updatedAt'])
        && request.resource.data.memberId == m && request.resource.data.updatedAt == request.time
        && request.resource.data.days is map && request.resource.data.days.size() <= 120;
      allow delete: if devWipe();
    }
    match /bodyLogs/{m} {
      allow get: if isMemberSelf(m) || isAdmin() || coachReads(m);
      allow create, update: if (isMemberSelf(m) || planWriter(m))
        && exactKeys(['memberId', 'entries', 'updatedAt'])
        && request.resource.data.memberId == m && request.resource.data.updatedAt == request.time
        && request.resource.data.entries is list && request.resource.data.entries.size() <= 200;
      allow delete: if devWipe();
    }
    match /exercises/{e} {
      allow read: if isStaff();
      allow create, update: if (hasRole('coach') || adminWriter())
        && e.matches('^[A-Za-z0-9_-]{2,40}$')
        && exactKeys(['nameAr', 'nameEn', 'muscle', 'tips', 'updatedAt', 'by'])
        && request.resource.data.nameAr is string && request.resource.data.nameAr.size() >= 1 && request.resource.data.nameAr.size() <= 60
        && request.resource.data.nameEn is string && request.resource.data.nameEn.size() <= 60
        && request.resource.data.muscle in ['chest', 'back', 'legs', 'shoulders', 'arms', 'core', 'cardio', 'full']
        && request.resource.data.tips is string && request.resource.data.tips.size() <= 300
        && request.resource.data.by == request.auth.uid && request.resource.data.updatedAt == request.time;
      allow delete: if hasRole('coach') || adminWriter();
    }
    // The admin assigns a coach (an active staff account with the coach role); the name goes on the file.
    function memberCoach(m) {
      let d = request.resource.data;
      return adminWriter()
        && onlyChanges(['assignedCoachId', 'assignedCoachName', 'updatedAt', 'lastAuditId'])
        && ((d.assignedCoachId == null && d.assignedCoachName == null)
            || (d.assignedCoachId is string && coachAccount(d.assignedCoachId, d.assignedCoachName)))
        && d.updatedAt == request.time
        && freshAudit('member.coach', 'members', m);
    }
    function coachAccount(u, name) {
      let c = get(userPath(u)).data;
      return c.kind == 'staff' && c.status == 'active' && 'coach' in c.roles && c.displayName == name;
    }

    // ================================================================ Phase 6: books and cash
    // Income/expense entries are append-only; an admin voids a mistake with a reason (never edits it).
    function bookWriter() { return signedIn() && writerOn(me(), ['admin', 'accountant', 'developer']); }
    match /financeEntries/{e} {
      allow read: if isAdmin() || isAccountant();
      allow create: if bookWriter() && financeShape() && freshAudit('finance.add', 'financeEntries', e);
      allow update: if adminWriter()
        && resource.data.status == 'ACTIVE'
        && onlyChanges(['status', 'voidReason', 'voidedBy', 'voidedAt', 'lastAuditId'])
        && request.resource.data.status == 'VOID'
        && request.resource.data.voidReason is string && request.resource.data.voidReason.size() >= 1 && request.resource.data.voidReason.size() <= 200
        && request.resource.data.voidedBy == request.auth.uid && request.resource.data.voidedAt == request.time
        && freshAudit('finance.void', 'financeEntries', e);
    }
    function financeShape() {
      let d = request.resource.data;
      return exactKeys(['kind', 'category', 'amount', 'method', 'date', 'note', 'status', 'voidReason', 'voidedBy', 'voidedAt', 'by', 'at', 'lastAuditId'])
        && ((d.kind == 'EXPENSE' && d.category in ['rent', 'salaries', 'utilities', 'equipment', 'maintenance', 'supplies', 'marketing', 'other'])
            || (d.kind == 'INCOME' && d.category in ['products', 'personal_training', 'lockers', 'other']))
        && d.amount is int && d.amount > 0 && d.amount <= 100000000
        && d.method in ['CASH', 'WALLET', 'INSTAPAY', 'BANK']
        && d.date is string && d.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && d.note is string && d.note.size() <= 200
        && d.status == 'ACTIVE' && d.voidReason == '' && d.voidedBy == null && d.voidedAt == null
        && d.by == request.auth.uid && d.at == request.time;
    }
    // A cashier closes their own drawer once per day (the id is uid_date, and closes are never edited).
    match /cashCloses/{c} {
      allow get, list: if isAdmin() || isAccountant() || (isStaff() && resource.data.by == request.auth.uid);
      allow create: if frontDeskWriter()
        && exactKeys(['date', 'by', 'expected', 'counted', 'diff', 'note', 'at', 'lastAuditId'])
        && request.resource.data.date is string && request.resource.data.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && c == request.auth.uid + '_' + request.resource.data.date
        && request.resource.data.by == request.auth.uid
        && request.resource.data.expected is int && request.resource.data.counted is int
        && request.resource.data.counted >= 0 && request.resource.data.counted <= 100000000
        && request.resource.data.diff == request.resource.data.counted - request.resource.data.expected
        && request.resource.data.note is string && request.resource.data.note.size() <= 200
        && request.resource.data.at == request.time
        && freshAudit('cash.close', 'cashCloses', c);
    }

    // ================================================================ content: banners and VIP tiers (admin)
    match /banners/{b} {
      allow read: if (active() && resource.data.status == 'PUBLISHED') || isAdmin();
      allow create, update: if adminWriter() && bannerShape(b) && freshAudit('banner.set', 'banners', b);
    }
    function bannerShape(b) {
      let d = request.resource.data;
      return b.matches('^[A-Za-z0-9_-]{2,40}$')
        && exactKeys(['title', 'body', 'tag', 'tone', 'figure', 'status', 'vipOnly', 'sort', 'endsAt', 'updatedAt', 'lastAuditId'])
        && d.title is string && d.title.size() >= 2 && d.title.size() <= 60
        && d.body is string && d.body.size() <= 140
        && d.tag is string && d.tag.size() >= 1 && d.tag.size() <= 20
        && d.tone in ['primary', 'vip', 'info']
        && d.figure in ['curl', 'abs', 'ropes', 'squat', 'flex', 'gear']
        && d.status in ['PUBLISHED', 'DRAFT', 'ARCHIVED']
        && d.vipOnly is bool
        && d.sort is int && d.sort >= 0 && d.sort <= 1000
        && (d.endsAt == null || d.endsAt is timestamp)
        && d.updatedAt == request.time;
    }
    match /vipTiers/{v} {
      allow read: if active();
      allow create, update: if v in ['PLUS', 'ELITE'] && adminWriter()
        && exactKeys(['nameAr', 'nameEn', 'perksAr', 'perksEn', 'updatedAt', 'lastAuditId'])
        && request.resource.data.nameAr is string && request.resource.data.nameAr.size() >= 1 && request.resource.data.nameAr.size() <= 30
        && request.resource.data.nameEn is string && request.resource.data.nameEn.size() >= 1 && request.resource.data.nameEn.size() <= 30
        && request.resource.data.perksAr is string && request.resource.data.perksAr.size() <= 600
        && request.resource.data.perksEn is string && request.resource.data.perksEn.size() <= 600
        && request.resource.data.updatedAt == request.time
        && freshAudit('vip.tier', 'vipTiers', v);
    }

    // ---------------------------------------------------------------- audit log (append-only)
    match /auditLogs/{aid} {
      allow get, list: if isAdmin();
      // signed in and the author; who may make the described change is checked on that document
      allow create: if signedIn() && auditShape(aid);
    }
    function auditShape(aid) {
      let d = request.resource.data;
      return exactKeys(['actorUid', 'action', 'entityType', 'entityId', 'at', 'summary'])
        && d.actorUid == request.auth.uid
        && d.at == request.time
        && d.action is string && d.action.size() <= 40
        && d.entityId is string
        && d.summary is map && d.summary.size() <= 8
        // the described document, changed in this same write, points back at this entry (each of those
        // documents has its own rules, so an entry can only describe a change that was allowed)
        && d.entityType in ['members', 'users', 'license', 'gymPublicConfig', 'pinSecrets', 'wipes', 'plans', 'gymSettings',
                            'memberships', 'banners', 'vipTiers', 'financeEntries', 'cashCloses', 'exercises']
        && getAfter(/databases/$(database)/documents/$(d.entityType)/$(d.entityId)).data.lastAuditId == aid;
    }

    // ---------------------------------------------------------------- later phases: read-only for now
    // Writes for these collections arrive with their phase (orders and payments in Phase 3, and so on),
    // each with its own rules and tests. Until then nobody can write them.
    match /membershipEvents/{id} { allow read: if isFrontDesk(); }
    match /orders/{id}           { allow read: if ownsMemberDoc() || isFrontDesk(); }
    match /cashSessions/{id}     { allow read: if isAdmin() || isAccountant() || (isCashier() && resource.data.cashierId == request.auth.uid); }
    match /offers/{id}           { allow read: if active(); }
    match /paymentMethods/{id}   { allow read: if active(); }
    match /notifications/{id}    { allow read: if signedIn() && resource.data.recipientId == request.auth.uid; }
  }
}
